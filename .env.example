# Copy to .env.local and populate locally. Never commit real credentials.
# Neon pooled connection for server-side application queries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"

# Direct connection used by Prisma CLI for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"
